# 不要提交真实密钥。复制为 .env 后，只在本机填写密钥。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# MSSQL账户与诊断日志。Windows本机可使用集成认证；云端应使用SQL账号。
MSSQL_SERVER=
MSSQL_DATABASE=NetDiagAgent
MSSQL_USERNAME=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=optional
MSSQL_TRUST_SERVER_CERTIFICATE=yes

# 至少24个随机字符；设备指纹只保存HMAC摘要，不保存原始IP或请求头。
AUTH_DEVICE_SECRET=
