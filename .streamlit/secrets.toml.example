# 只将下面三个配置项填入平台的 Secrets 管理页面；真实密钥必须由本人填写。
# 不要将填写后的配置提交到GitHub，不要发送密钥给助手。
LLM_API_KEY = ""
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-flash"

# MSSQL账户、设备绑定和诊断日志。不要提交填写后的文件。
MSSQL_SERVER = ""
MSSQL_DATABASE = "NetDiagAgent"
MSSQL_USERNAME = ""
MSSQL_PASSWORD = ""
MSSQL_DRIVER = "ODBC Driver 18 for SQL Server"
MSSQL_TRUSTED_CONNECTION = "false"
MSSQL_ENCRYPT = "yes"
MSSQL_TRUST_SERVER_CERTIFICATE = "no"
AUTH_DEVICE_SECRET = ""
# 云端临时登录模式（SQLite文件在Community Cloud上不保证持久化）
# DATABASE_BACKEND = "sqlite"
# AUTH_DEVICE_SECRET = "replace-with-at-least-24-random-characters"
# SQLITE_PATH = "/tmp/netdiag_agent/netdiag_demo.db"
